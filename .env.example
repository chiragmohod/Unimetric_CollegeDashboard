# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_API_BASE_URL="http://localhost:4000"

# ============================================
# GENERAL SERVER CONFIGURATION
# ============================================
NODE_ENV="development"
PORT="4000"

# ============================================
# AI SERVICE CONFIGURATION
# ============================================
GEMINI_API_KEY="your-gemini-api-key"

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Options: "local", "supabase", "postgresql", "mysql", "mongodb"
DATABASE_TYPE="local"

# For local/file-based storage (development):
# No additional configuration needed - uses server/db.json

# For Supabase:
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# For PostgreSQL (direct connection):
# DATABASE_URL="postgresql://user:password@localhost:5432/unimetric"
# Or use individual settings:
# DB_HOST="localhost"
# DB_PORT="5432"
# DB_NAME="unimetric"
# DB_USER="postgres"
# DB_PASSWORD="your-password"

# For MySQL:
# DATABASE_URL="mysql://user:password@localhost:3306/unimetric"
# Or use individual settings:
# DB_HOST="localhost"
# DB_PORT="3306"
# DB_NAME="unimetric"
# DB_USER="root"
# DB_PASSWORD="your-password"

# For MongoDB:
# DATABASE_URL="mongodb://user:password@localhost:27017/unimetric"
# Or MongoDB Atlas:
# DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/unimetric"

# ============================================
# STORAGE CONFIGURATION
# ============================================
# Options: "local", "supabase", "aws-s3", "gcp-storage", "azure-blob"
STORAGE_TYPE="local"

# For local file storage:
UPLOAD_DIR="./uploads"

# For Supabase Storage:
# SUPABASE_STORAGE_BUCKET="classroombucket"

# For AWS S3:
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_S3_BUCKET="your-bucket-name"

# For Google Cloud Storage:
# GCP_PROJECT_ID="your-project-id"
# GCP_KEY_FILE="path/to/service-account-key.json"
# GCP_BUCKET="your-bucket-name"

# For Azure Blob Storage:
# AZURE_STORAGE_ACCOUNT="your-account"
# AZURE_STORAGE_KEY="your-key"
# AZURE_STORAGE_CONTAINER="your-container"

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET="your-jwt-secret-key-change-this"
SESSION_SECRET="your-session-secret-key-change-this"

# Admin credentials (change in production!)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="12345678"

# ============================================
# DEPLOYMENT & CLOUD CONFIGURATION
# ============================================
# App deployment URL (for self-referential links, OAuth callbacks)
APP_URL="http://localhost:3000"

# For Vercel deployment:
# VERCEL_URL is automatically set by Vercel

# For Render deployment:
# RENDER_EXTERNAL_URL is automatically set by Render

# For AWS deployment:
# AWS_REGION="us-east-1"

# For Google Cloud Run:
# No special configuration needed

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL="info"
# Options: "error", "warn", "info", "debug"
